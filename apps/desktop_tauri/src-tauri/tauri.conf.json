{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "WinKey Pro",
  "version": "0.2.6",
  "identifier": "com.winkey.pro",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinKey Pro",
        "url": "index.html",
        "visible": true,
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}